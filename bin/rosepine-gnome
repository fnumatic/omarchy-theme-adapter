#!/usr/bin/env bash
# rosepine-gnome — Rose Pine Dawn als GNOME-Theme via Omarchy-color.toml (Option B).
# Stand: Parser + Ghostty-Terminal-Adapter; GTK/Shell-Adapter folgen.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT/src/lib-colors.sh"
source "$ROOT/src/render-ghostty.sh"

usage() {
  cat <<'EOF'
rosepine-gnome — Rose Pine Dawn als GNOME-Theme (aus Omarchy colors.toml)

Verwendung:
  rosepine-gnome parse [--colors FILE]        colors.toml normalisiert ausgeben
  rosepine-gnome render ghostty [--colors FILE]
                                              Ghostty-Theme (.conf) auf stdout rendern
  rosepine-gnome install ghostty [--dry-run] [--colors FILE]
                                              Ghostty-Theme installieren + config setzen
  rosepine-gnome apply [--dry-run] [--colors FILE]
                                              System-Light-Schema setzen (MVP)

Optionen:
  --colors FILE   alternatives colors.toml (Standard: themes/rose-pine/colors.toml)
  --dry-run       nur anzeigen, was geändert würde
  -h, --help      diese Hilfe
EOF
}

log()  { printf '\033[1;34m[*]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[x]\033[0m %s\n' "$*" >&2; exit 1; }

DRY=0
COLORS_FILE=""
CMDS=()

# --- Kommando & Argumente ---
[[ $# -eq 0 ]] && { usage; exit 0; }
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --dry-run) DRY=1 ;;
    --colors)  COLORS_FILE="$2"; shift ;;
    --) shift ;;
    -*) die "Unbekannte Option: $1" ;;
    *)  CMDS+=("$1") ;;
  esac
  shift
done

if [[ -z "$COLORS_FILE" ]]; then
  COLORS_FILE="$ROOT/themes/rose-pine/colors.toml"
fi
colors_parse "$COLORS_FILE" || die "colors.toml konnte nicht geparst werden: $COLORS_FILE"

run() { # führt Kommando aus bzw. zeigt es bei --dry-run
  if [[ "$DRY" -eq 1 ]]; then printf '  dry-run: %s\n' "$*"; else "$@"; fi
}

have() { command -v "$1" >/dev/null 2>&1; }

case "${CMDS[0]:-}" in
  parse)
    colors_semantic
    exit 0
    ;;
  render)
    case "${CMDS[1]:-}" in
      ghostty) render_ghostty ;;
      *) die "render: unbekanntes Ziel '${CMDS[1]:-}' (ghostty)" ;;
    esac
    exit 0
    ;;
  install)
    case "${CMDS[1]:-}" in
      ghostty) install_ghostty ;;
      *) die "install: unbekanntes Ziel '${CMDS[1]:-}' (ghostty)" ;;
    esac
    exit 0
    ;;
  apply)
    log "Anwenden von Rose Pine Dawn (${_C_mode:-light})"
    schema="org.gnome.desktop.interface"
    if have gsettings; then
      run gsettings set "$schema" color-scheme prefer-light
      printf '   ✓ color-scheme: prefer-light\n'
    else
      warn "gsettings nicht gefunden — light-schema übersprungen."
    fi
    printf '   − Icon-Theme/Wallpaper: offen (PROJECT.md §13); Ghostty: rosepine-gnome install ghostty\n'
    exit 0
    ;;
  *)
    die "Unbekanntes Kommando: ${CMDS[0]:-} (siehe --help)"
    ;;
esac