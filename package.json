{
  "name": "omarchy-theme-adapter",
  "version": "0.1.1",
  "private": true,
  "description": "Apply Omarchy themes to an Ubuntu GNOME system (Ghostty, GTK3, GTK4, PaperWM, LibreOffice, VS Code) from their colors.toml.",
  "type": "module",
  "license": "MIT",
  "author": "uninow <mail@fnumatic.de>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fnumatic/omarchy-theme-adapter.git"
  },
  "homepage": "https://github.com/fnumatic/omarchy-theme-adapter#readme",
  "bugs": {
    "url": "https://github.com/fnumatic/omarchy-theme-adapter/issues"
  },
  "keywords": [
    "omarchy",
    "gnome",
    "theme",
    "gtk3",
    "gtk4",
    "ghostty",
    "paperwm",
    "libreoffice",
    "vscode",
    "colors-toml",
    "ubuntu"
  ],
  "engines": {
    "bun": ">=1"
  },
  "bin": {
    "themeswitch": "./src/cli.ts"
  },
  "scripts": {
    "cli": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "^1",
    "css-tree": "^3.2.1",
    "typescript": "^7.0.2"
  }
}
